# Supabase project (anon key is public by design; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=https://bfyrnqriusicvgwxogwr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Oryn backend (WebSocket for voice/text, HTTP for /memories)
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_BACKEND_HTTP_URL=http://localhost:8000

# Show "Continue with Google" and "Link Google account". Set to true only after enabling the
# Google provider in Supabase Auth. Default (unset/false): guest mode only.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
