# copy to backend/.env — never commit real values
APP_ENV=development
PROVIDER_MODE=live            # live | fake (fake = offline, no keys needed)
CORS_ORIGINS=http://localhost:3000

# Supabase
SUPABASE_URL=https://bfyrnqriusicvgwxogwr.supabase.co
SUPABASE_JWT_SECRET=          # legacy HS256 secret, or leave empty to use JWKS
SUPABASE_SERVICE_ROLE_KEY=

# Gnani (Prisma STT + Timbre TTS) — one key for both
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=
GNANI_TTS_MAX_CONCURRENT=1

# Sarvam conversational LLM
SARVAM_API_KEY=
LLM_MODEL=

# Embeddings for memory (OpenAI-compatible)
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
EMBEDDINGS_DIMENSIONS=        # vector size of EMBEDDINGS_MODEL (required when embeddings are set)

MEMORY_DB_PATH=./data/memory.db
